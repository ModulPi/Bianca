# 复制为 .env 并填入真实密钥：copy .env.example .env
# Copy to .env and fill in real secrets (never commit .env)

# 币安 Demo 现货（在 demo.binance.com 创建，如 Fkey）
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_BASE_URL=https://demo-api.binance.com
# 大陆等地区访问币安 API 需代理（451 地区限制）。Docker 内指向本机 Clash/V2Ray 示例：
# BINANCE_PROXY=http://host.docker.internal:7890

# LLM — PoC 默认 DeepSeek；切换 Ollama 见 docs/system-design/系统设计文档-Bianca.md
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_AUTO_EXECUTE=true
# EXECUTION_MODE=auto|semi_auto|signal_only（优先于 LLM_AUTO_EXECUTE）
# EXECUTION_MODE=semi_auto
LLM_TIMEOUT=30

# 风控
MAX_TRADE_AMOUNT=50
DAILY_LOSS_LIMIT=100
MIN_CONFIDENCE=0.6
MAX_POSITION_PCT=0.8
MAX_DRAWDOWN_USDT=50
CIRCUIT_BREAKER_FAILURES=3
STOP_LOSS_USDT=25
PENDING_SIGNAL_TTL_MINUTES=30

# Agent — 自主交易引擎
AGENT_TICK_INTERVAL=60
TRADE_SYMBOL=BTCUSDT
AGENT_SYMBOLS=BTCUSDT
AGENT_MAX_PARALLEL=8
TRADE_MARKET=crypto
AUTO_DEGRADE_ENABLED=true
AUTO_DEGRADE_FAILURES=3
AGENT_STOP_ON_LOOP_CLOSED=false
# conservative | aggressive（PoC 激进：优先完成买卖闭环）
TRADING_STYLE=conservative
POC_MIN_TRADE_USDT=10

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/bianca.db

# 服务
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# M8 — Telegram 通知与模拟门禁
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
NOTIFY_ON_SESSION_CLOSE=true
NOTIFY_ON_RISK_REJECT=true
TRADING_MODE=demo
PAPER_VALIDATION_MIN_HOURS=24
PAPER_VALIDATION_REQUIRE_LOOP=true
FUTURES_ENABLED=false
LIVE_TRADING_CONFIRMED=false

# M4 — PostgreSQL + Redis（可选，见 docker-compose.mvp.yml）
# DATABASE_URL=postgresql+asyncpg://bianca:bianca@postgres:5432/bianca
# REDIS_URL=redis://redis:6379/0

# MVP 安全
# API_TOKEN=your-secret-token
# ENCRYPTION_KEY=change-me-to-a-long-random-string

# MVP 邮件通知
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# NOTIFY_EMAIL_TO=you@example.com
# NOTIFY_EMAIL_FROM=bianca@example.com

# MVP 会话快照与 K 线
SESSION_SNAPSHOT_INTERVAL_MINUTES=15
KLINES_ENABLED=true
KLINES_INTERVAL=1m
DEFAULT_TRADE_MARKET=spot
METRICS_ENABLED=true
