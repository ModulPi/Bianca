# 复制为 .env 并填入真实密钥：copy .env.example .env
# Copy to .env and fill in real secrets (never commit .env)

# 币安 Demo 现货（在 demo.binance.com 创建，如 Fkey）
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_BASE_URL=https://demo-api.binance.com
# 大陆等地区访问币安 API 需代理（451 地区限制）。Docker 内指向本机 Clash/V2Ray 示例：
# BINANCE_PROXY=http://host.docker.internal:7890

# LLM — PoC 默认 DeepSeek；切换 Ollama 见 docs/system-design/系统设计文档-Bianca.md
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_AUTO_EXECUTE=true
LLM_TIMEOUT=30

# 风控
MAX_TRADE_AMOUNT=50
DAILY_LOSS_LIMIT=100

# Agent
AGENT_TICK_INTERVAL=300
TRADE_SYMBOL=BTCUSDT

# 行情数据模块（见 docs/outline-design/模块设计/行情数据模块设计-Bianca.md）
# 行情一律取**实盘**数据（ADR-013），交易仍走上面的 Binance Demo。
# 代理复用 BINANCE_PROXY —— 实测直连 api.binance.com 超时，不做双路径。
MARKET_REST_BASE_URL=https://api.binance.com
MARKET_WS_BASE_URL=wss://stream.binance.com:9443/ws
MARKET_DATABASE_URL=sqlite+aiosqlite:///./data/market.db
# 逗号分隔；采集层按「订阅集合」建模（ADR-016）
MARKET_SYMBOLS=BTCUSDT
MARKET_INTERVAL=1m
# 保留 10 年（ADR-015）；回补从币安 1m 数据起点 2017-08-17 开始（ADR-014）
MARKET_RETENTION_DAYS=3650
MARKET_BACKFILL_START=2017-08-17
# 首次启动后台回补全历史（约 4800 次请求 / 并发 5 约 10-20 分钟），不阻塞服务启动
MARKET_BACKFILL_ON_START=true
MARKET_BACKFILL_CONCURRENCY=5
# 只在 API 进程内拉起采集器。数据面迁到独立入口（python -m agent.market，
# 由计划任务守护）后，这里应为 false —— 否则两个采集器会抢同一个库的锁。
# 它**不**参与健康判定：/health 的 market 字段只看库里的数据新不新鲜 + 内核锁
# 在不在别人手里，所以不会有"关掉开关 → 告警跟着静默"这种坑。
MARKET_COLLECTOR_AUTOSTART=true
# 给 LLM 的行情上下文预算硬上限（ADR-012）
MARKET_MAX_CONTEXT_CHARS=2000

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/bianca.db

# 服务
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
